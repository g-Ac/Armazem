# Banco local (criado automaticamente na pasta runtime/)
DB_PATH=runtime/automacao.db

# Alvo HTTP para monitorar (troque pelo seu site ou API)
CHECK_URL=https://example.com
DISK_WARN_PCT=85
CHECK_INTERVAL_SEC=60

# Opcional: preencha para receber alertas reais no Telegram (via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
